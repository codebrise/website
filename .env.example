# CodeBrise Production Environment Variables
# Copy to .env.local for local testing or set in hosting provider dashboard (e.g. Cloudflare Pages / Vercel)

# Production Site URL (used for canonical tags, sitemaps, RSS feeds, and Open Graph previews)
NEXT_PUBLIC_SITE_URL=https://codebrise.com

# Search Console Verification Codes
# Google Search Console HTML tag content: <meta name="google-site-verification" content="..." />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code: <meta name="msvalidate.01" content="..." />
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Privacy-Friendly Web Analytics (Zero-cookie, GDPR compliant)
# Cloudflare Web Analytics beacon token:
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
